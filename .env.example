# ── Доставка заявок ──
# Полная заявка (ПД: телефон, email, диалог) уходит письмом на РОССИЙСКИЙ ящик
# через российский SMTP — так ПД остаётся в РФ-контуре (152-ФЗ).
SMTP_HOST=          # напр. smtp.yandex.ru
SMTP_PORT=465       # 465 (SSL) или 587 (STARTTLS)
SMTP_USER=          # адрес-отправитель, напр. leads@example.ru
SMTP_PASS=          # ПАРОЛЬ ПРИЛОЖЕНИЯ (не основной пароль от почты!)
LEAD_TO=            # куда слать заявки (по умолчанию = SMTP_USER)
# LEAD_FROM=        # опционально, по умолчанию = SMTP_USER

# Telegram — теперь только ПИНГ без ПД («пришла заявка, проверь почту»).
# Персональные данные в Telegram НЕ отправляются. Можно не заполнять — тогда
# останется только email.
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── LLM демо-модулей: DeepSeek — основной, OpenAI — резерв (см. lib/llm.ts) ──
# ВАЖНО: с российского сервера api.openai.com недоступен (OpenAI блокирует РФ IP),
# поэтому реально работает DeepSeek. Проверить доступность DeepSeek с РФ-сервера!
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# опционально: переопределить URL/модель первого доступного провайдера
# LLM_BASE_URL=
# LLM_MODEL=

# ── Durable rate-limit (Upstash Redis) ──
# Без них лимиты работают только in-memory (слабее).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# дневной потолок запросов к LLM на весь сайт (защита от накрутки счёта), по умолчанию 800
# LLM_DAILY_CAP=800
